% Keep the size of this file to a minimum to reduce preview compilation time in TikZiT %
\usepackage{amsfonts}
\usepackage{mathtools}

\usepackage{extarrows}
\usepackage{physics}
\usepackage{amssymb}

% Shorter minus and plus signs
\newcommand{\minu}{\texttt{-}}
\newcommand{\plus}{\texttt{+}}
\newcommand{\FaultEq}{\mathrel{\widehat{=}}}
\newcommand{\wFaultEq}[1]{\underset{#1}{\FaultEq}}
\newcommand{\NotFaultEq}{\not\mathrel{\widehat{=}}}
\newcommand{\LHS}{\textsf{LHS}\xspace}
\newcommand{\RHS}{\textsf{RHS}\xspace}

% used in ZX-diagrams
\definecolor{zxRed}{RGB}{232, 165, 165}
\definecolor{zxGreen}{RGB}{216, 248, 216}
\definecolor{zxGreen}{RGB}{216, 248, 216}
\definecolor{zxHad}{RGB}{255, 255, 130}
\definecolor{zxGrey}{RGB}{211,211,211}
\definecolor{zxDarkRed}{RGB}{150, 100, 100}
\definecolor{zxDarkGreen}{RGB}{158, 200, 158}
\definecolor{verylightgray}{RGB}{235,235,235}


\usepackage{pgfplots}
\pgfplotsset{compat=newest, compat/show suggested version=false}
\usetikzlibrary{decorations, arrows.meta, calc}

% A paired filter is one projector, with one colour for each bounded axis.
\tikzset{split filter label scale/.initial=0.7}
\tikzset{split filter/.style args={#1/#2/#3/#4/#5/#6}{path picture={%
  \fill[#1] (path picture bounding box.north west)
    rectangle (path picture bounding box.east);
  \fill[#2] (path picture bounding box.west)
    rectangle (path picture bounding box.south east);
  \node[inner sep=0pt, font=\scriptsize, scale=\pgfkeysvalueof{/tikz/split filter label scale}, text=#5]
    at ($(path picture bounding box.center)!0.5!(path picture bounding box.north)$) {#3};
  \node[inner sep=0pt, font=\scriptsize, scale=\pgfkeysvalueof{/tikz/split filter label scale}, text=#6]
    at ($(path picture bounding box.center)!0.5!(path picture bounding box.south)$) {#4};
}}}

% Abstract axes use the same split bar, with high-contrast labels inside it.
\tikzset{frame axes/.style args={#1/#2}{%
  split filter={white/black/$#1$/$#2$/black/white}}}

\tikzset{addcross/.style={draw,path picture={%
  \draw[black]
       (path picture bounding box.north) -- (path picture bounding box.south)
       (path picture bounding box.west) -- (path picture bounding box.east);
}}}
\tikzset{addmeter/.append style={%
  draw, scale=0.3, inner sep=10, rectangle, font=\vphantom{A}, minimum width=30, path picture={%
    \draw[black, line width=.1] ([shift={(.1,.2)}] path picture bounding box.south west) to [bend left=50] ([shift={(-.1,.2)}] path picture bounding box.south east);
    \draw[black,-latex, line width=.01] ([shift={(0,.1)}] path picture bounding box.south) -- ([shift={(.3,-.1)}] path picture bounding box.north);
  }
}}

